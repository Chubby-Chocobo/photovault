// Copy to Config/Secrets.xcconfig (gitignored) and fill in the Desktop OAuth client from
// Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-replace-me
// Dropbox Console → your app → Settings → App key (public client, PKCE; no secret).
// Leave it empty to build without Dropbox: the "From Dropbox…" item then shows as disabled.
DROPBOX_APP_KEY =
